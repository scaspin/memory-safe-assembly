diff --git a/lib/stat.ml b/lib/stat.ml
index 47a2532..b8439ed 100644
--- a/lib/stat.ml
+++ b/lib/stat.ml
@@ -19,3 +19,10 @@ let statistics_to_file (filename: string) =
     stat.smt_queries
     stat.smt_queries_time;
   close_out channel
+
+let time_func (phase: string) (func_name: string) (f: unit -> 'a) : 'a =
+  let start_time = Sys.time () in
+  let start_queries = stat.smt_queries in
+  let result = f () in
+  Printf.printf "OCTAL_FUNC_TIME %s %s %f %d\n%!" phase func_name (Sys.time () -. start_time) (stat.smt_queries - start_queries);
+  result
